[Unit]
Description=Daily Controlled System Update timer
Documentation=https://github.com/Green-Needle-Tech/controlled-system-update

[Timer]
# Run at 04:00 with up to 30min random delay to avoid herd effects
OnCalendar=*-*-* 04:00:00
RandomizedDelaySec=30m
# If the machine was off, don't catch up on missed runs
Persistent=false

[Install]
WantedBy=timers.target
