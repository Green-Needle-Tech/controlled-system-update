[Unit]
Description=Controlled System Update - Automatic OS, Docker, and Hermes update
Documentation=https://github.com/Green-Needle-Tech/controlled-system-update
Wants=network-online.target
After=network-online.target docker.service
ConditionACPower=true

[Service]
Type=oneshot
ExecStart=/usr/local/bin/auto-update.sh
# Config file location (set CSU_CONFIG if not using default path)
# Environment=CSU_CONFIG=/etc/controlled-system-update/auto-update.conf
# Resource limits
MemoryMax=1G
CPUWeight=50
# Timeout (90 minutes).
# A full run is OS + snap + Docker image pulls + `hermes update` (which
# rebuilds the web UI) + diagnostics. On slower arm64 hosts the Node/Vite
# build alone can eat a large share of the old 1h budget. Every inner phase
# has its own tighter timeout, so this is a backstop only.
TimeoutStartSec=5400
# Nice level (lower priority — don't starve production services)
Nice=10
IOSchedulingClass=best-effort
IOSchedulingPriority=7
# Restrict file creation permissions.
# NOTE: the key is UMask (capital M). `Umask` is silently ignored and logs
# "Unknown key name 'Umask' in section 'Service'" on every daemon-reload.
UMask=0077
# Logging
StandardOutput=journal
StandardError=journal

[Install]
WantedBy=multi-user.target
